  if(!result.known)return '<div class="v43coverage"><b>Dekking per Pokémon-soort nog onbekend</b><p>De vermelde Pokémon-soorten konden niet worden herkend. Controleer de evenementbron.</p></div>';
  const count=result.covered.length;
  const ratio=Math.round(count/result.known*100);
  const title=result.unknown.length?`${count} van ${result.known} herkende soorten`:`${count} van ${result.total} vermelde wilde soorten`;
  const hasListedNames=e.confidence==='listed';
  const add=(label,names,cls)=>names.length?`<p class="${cls}"><b>${label}:</b> ${esc(names.join(', '))}</p>`:'';
  return `<div class="v43coverage"><b>Vangbonus bij ${esc(title)}</b>`+
    `<div class="v43track" role="img" aria-label="${esc(title)} met passende typebonus"><span style="width:${ratio}%"></span></div>`+
    add('Met bonus',result.covered,'v43covered')+
    add('Zonder bonus',result.uncovered,'v43uncovered')+
    add('Typen onbekend',result.unknown,'v43unknown')+
    `<p class="v43footnote">${hasListedNames?'Gebaseerd op de vermelde wilde Pokémon.':'Voorlopig: de wilde Pokémon-lijst kan onvolledig zijn.'} Soorten zijn niet gewogen naar hoe vaak je ze vangt.</p></div>`;
