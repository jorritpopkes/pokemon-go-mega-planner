function feedAuditV46(){
  let stamp=null;
  try {
    const raw=localStorage.getItem('pogo-mega-live-feed-v46');
    if(raw){const parsed=new Date(raw);if(Number.isFinite(parsed.getTime())&&parsed.getTime()<=Date.now())stamp=parsed;}
  }catch(e){}
  const hours=stamp?(Date.now()-stamp.getTime())/3600000:null;
  return {stamp,hours,fresh:hours!==null&&hours<=48};
}
function eventEvidence(e){
  const evidence=originalEventEvidenceV46(e);
  if(e.manual||String(e.id||'').startsWith('customevent_'))return evidence;
  const audit=feedAuditV46();
  if(feedMode==='live'&&feedState==='ok'&&audit.fresh)return evidence;
  let note;
  if(!audit.stamp) note='De wilde-spawngegevens zijn nog niet opnieuw bevestigd in deze versie. Controleer de evenementbron.';
  else if(!audit.fresh)note='De laatste geslaagde livecontrole is meer dan 48 uur geleden. De soortenlijst kan veranderd zijn.';
  else note='De laatste geslaagde livecontrole was eerder. Op dit moment konden de gegevens niet opnieuw bevestigd worden.';
  return evidence+'<div class="v46uncertain">'+esc(note)+'</div>';
}
