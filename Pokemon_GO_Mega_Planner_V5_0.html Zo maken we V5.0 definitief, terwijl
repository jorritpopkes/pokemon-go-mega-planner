  const names=coverage.known?` ${other.name} dekt ${coverage.covered.length} van ${coverage.known} herkende wilde soorten.`:'';
  const diff=competitor.points-selectedScore;
  // The numerical difference is a relative model score, NOT a count of XL Candy.
  if(diff<=0)return `${other.name} is ook geschikt, maar ${m.name} heeft voor dit evenement een minstens even hoge directe modelscore.${names}`;
  const prefix=`${other.name} heeft ${Math.round(diff)} punten meer in de directe modelscore (geen voorspelling van Candy XL).`;
  if(!info||info.alternativeId!==other.id)
    return `${prefix} De exacte gratis-beschikbaarheid in deze simulatie kan niet worden vastgesteld.${names} Controleer Pokémon GO.`;
  if(info.status==='unknown')return `${prefix} De planner kent geen betrouwbare gratis-tijd voor ${other.name}; daarom kan die optie niet als gratis worden ingepland.${names}`;
  if(info.status==='cooldown'){
    const ready=new Date(info.readyAt);
    const known=Number.isFinite(+ready);
    const date=known?`${fmtDay(ready)} om ${fmtTime(ready)}`:'een nog onbekend tijdstip';
    const last=info.lastUsedAt?` In deze planning is ${other.name} eerder ingezet op ${fmtDay(new Date(info.lastUsedAt))} om ${fmtTime(new Date(info.lastUsedAt))}.`:'';
    return `${prefix} ${other.name} is op dit speelmoment volgens de simulatie nog niet gratis: pas ${date}.${last} Daarom is ${m.name} de beschikbare optie.${names}`;
  }
