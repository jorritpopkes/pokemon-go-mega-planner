@media(max-width:500px){.v42choice{padding:10px}.v42choice>div{justify-content:flex-start}}

/* V4.4: Distinct named wild Pokémon per Mega, with explicitly unknown species. */
.v43coverage{background:#132a34;border:1px solid #416a6d;border-radius:10px;padding:9px 10px;margin:10px 0}
.v43coverage>b{display:block;color:#b2f1df;font-size:12px;margin-bottom:6px}
.v43coverage p{font-size:11px;line-height:1.5;margin:5px 0;overflow-wrap:anywhere}
.v43coverage .v43covered{color:#b7f0d6}
.v43coverage .v43uncovered{color:#d0dce8}
.v43coverage .v43unknown{color:#f1d5a3}
.v43coverage .v43footnote{color:#acc6cb;font-size:10.5px;margin-top:7px}
.v43track{height:7px;border-radius:20px;overflow:hidden;background:#33485b;margin:6px 0 8px}
.v43track span{display:block;height:100%;background:#5ecbb1;border-radius:20px}

/* V4.6: zichtbare versheid van de evenementenbron, ook als de livebron uitvalt. */
.v46feed{padding:8px 9px;border-radius:9px;margin:8px 0;line-height:1.5;font-size:12px}
.v46feed.v46fresh{background:#1b3c35;color:#b8efda;border:1px solid #41725e}
