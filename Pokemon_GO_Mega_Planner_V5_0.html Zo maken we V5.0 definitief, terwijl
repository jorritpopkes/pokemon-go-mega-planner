function speciesCoverageV43(m,e){
  const wild=Array.isArray(e?.wildNames)?e.wildNames:[];
  const seen=new Set(),covered=[],uncovered=[],unknown=[];
  const bonusTypes=Array.isArray(m?.types)?m.types:[];
  for(const original of wild){
    const name=String(original||'').trim();
    if(!name)continue;
    const key=normalizeSpeciesV3(name)||name.toLowerCase();
    if(seen.has(key))continue;
    seen.add(key);
    const types=dexLookupV3(name);
    if(!Array.isArray(types)||!types.length){unknown.push(name);continue;}
    if(types.some(t=>bonusTypes.includes(t)))covered.push(name);
    else uncovered.push(name);
  }
  return {covered,uncovered,unknown,known:covered.length+uncovered.length,total:seen.size};
}
function speciesCoverageMarkupV43(m,e){
