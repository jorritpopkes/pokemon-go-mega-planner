      message:`${active.m.name} is al Mega-actief${endText}. Houd de bonus zolang je vangt; opnieuw evolueren is niet nodig. Bij wisselen begint zijn cooldown eerder. Zonder bekend wild-spawnevenement is er geen gegarandeerde beste Candy XL-typekeuze.`};
  }
  const free=known.filter(x=>x.state.kind==='free');
  if(!free.length){
    const waiting=known.filter(x=>x.state.kind==='waiting'&&x.state.free)
      .sort((a,b)=>a.state.free-b.state.free);
    const soon=waiting[0];
    return soon?{kind:'waiting',title:'Nog geen gratis Mega beschikbaar',event:null,
      message:`Volgens je registratie is ${soon.m.name} als eerste weer gratis op ${fmtDay(soon.state.free)} om ${fmtTime(soon.state.free)}. De planner adviseert geen betaalde evolutie. Controleer de werkelijke cooldown in Pokémon GO.`}:
      {kind:'none',title:'Geen gratis Mega bevestigd',event:null,
      message:'Er is nu geen gratis of actieve Mega bevestigd. Controleer zo nodig de cooldown in Pokémon GO; de planner gaat niet gokken.'};
  }
  const future=(plan||[]).flatMap(day=>day.actions||[])
    .filter(x=>x.slot?.t>now&&x.action?.kind==='event'&&x.action.m)
    .sort((a,b)=>a.slot.t-b.slot.t);
  const options=free.map(({m,state})=>{
    const nextFree=now.getTime()+8*V31_HOUR+coolDays(m)*V31_DAY;
    // Preserve an event Mega whenever a new full activation could block its next free use.
    // An actual earlier switch can improve readiness, but is not assumed here.
    const reserved=future.find(x=>x.action.m.id===m.id&&x.slot.t.getTime()<nextFree);
    const canProgress=+m.level<3&&!alreadyLeveledOnV32(m,now);
    return {m,state,reserved,canProgress,days:coolDays(m)};
  });
  const safe=options.filter(x=>!x.reserved).sort((a,b)=>
    a.days-b.days || Number(b.canProgress)-Number(a.canProgress) || +b.m.level-+a.m.level || a.m.name.localeCompare(b.m.name));
  if(!safe.length){
    const first=options.filter(x=>x.reserved).sort((a,b)=>a.reserved.slot.t-b.reserved.slot.t)[0];
    return {kind:'hold',title:'Bewaar je gratis Megas',event:null,
      message:`De beschikbare Megas zijn binnen hun mogelijke cooldownperiode gepland voor latere evenementen, waaronder ${first.reserved.slot.e.name} op ${fmtDay(first.reserved.slot.t)}. De planner adviseert nu geen nieuwe evolutie. Een eerdere wissel kan de cooldown verkorten, maar is nog niet bevestigd.`};
  }
  const first=safe[0],m=first.m;
  const benefit=first.canProgress?`Deze evolutie kan ook meetellen voor zijn volgende Mega Level, zolang je ${m.name} vandaag nog niet hebt geleveld.`:
    +m.level>=3?'Zijn maximale Mega-levelvoortgang is bereikt; opnieuw evolueren helpt niet meer met levelen.':
      'Vandaag is voor deze Mega al voortgang geregistreerd; opnieuw evolueren verhoogt zijn Mega-levelvoortgang niet nogmaals.';
  const extra=safe.find(x=>x.canProgress&&x.m.id!==m.id);
  const extraText=extra?` Voor extra gratis Mega-levelvoortgang kun je eventueel ook ${extra.m.name} inzetten, maar een wissel beëindigt de vorige bonus.`:'';
  return {kind:'free',title:m.name,event:null,
    message:`Als je nu gaat vangen, is ${m.name} een flexibele gratis optie: cooldown ${first.days} ${first.days===1?'dag':'dagen'} nadat de Mega Evolution eindigt. ${benefit} Er is geen bekend lopend wild-spawnevenement met voldoende typen; dit is dus geen bewezen beste Candy XL-match. ${m.name} is in de huidige planning niet nodig voordat de volgende volledige cooldown verstreken zou zijn.${extraText} Controleer GRATIS in Pokémon GO en registreer alleen een echte activatie.`};
}
function nowAdviceV37(now,plan){
  const ongoing=db.events.filter(e=>eventEligibleV31(e)&&dt(e.start)&&dt(e.end)&&dt(e.start)<=now&&dt(e.end)>now)
    .sort((a,b)=>eventPriorityV31(b)-eventPriorityV31(a)||
      (confidenceV37(a).level==='strong'?-1:1)-(confidenceV37(b).level==='strong'?-1:1));
  if(!ongoing.length)return quietAdviceV38(now,plan);
  const e=ongoing[0],eventConfidence=confidenceV37(e);
  const matches=db.megas.filter(activeMega).filter(m=>matching(m,e).length).map(m=>({m,score:eventRewardV35(m,e,now),s:stateAt(m,now)}));
  const available=matches.filter(x=>x.s.kind==='free'||x.s.kind==='active');
  if(!available.length)return {kind:'unknown',title:'Geen bevestigde gratis match',message:`${e.name} loopt nu, maar voor de passende Megas is geen gratis evolutie bevestigd. Controleer eerst de status in Pokémon GO; betaalde evoluties staan niet in dit advies.`,event:e};
  const future=plan.flatMap(d=>d.actions||[]).filter(x=>x.slot.t>now&&x.action.kind==='event'&&x.action.m&&x.slot.e.id!==e.id);
  const ranked=available.map(x=>{
    const next=future.find(f=>f.action.m.id===x.m.id&&f.slot.t.getTime()<now.getTime()+8*V31_HOUR+coolDays(x.m)*V31_DAY&&eventPriorityV31(f.slot.e)>eventPriorityV31(e));
    return {...x,reservedFor:next||null,adjusted:x.score*(next?0.48:1)};
  }).sort((a,b)=>b.adjusted-a.adjusted);
  const active=ranked.find(x=>x.s.kind==='active');
  const winner=active&&active.adjusted>=ranked[0].adjusted*0.85?active:ranked[0];
  const types=matching(winner.m,e).join(' en '),isActive=winner.s.kind==='active';
  const alternate=ranked.find(x=>x.m.id!==winner.m.id);
  let reason=`${winner.m.name} dekt ${types} (Mega Level ${winner.m.level}). `;
  reason+=isActive?'Deze Mega is al actief; opnieuw evolueren is niet nodig.':
    'Volgens jouw registratie is deze Mega gratis. Registreer de evolutie pas als je hem echt activeert.';
  if(winner.reservedFor)reason+=isActive?` Let op: deze Mega is ook voorzien voor ${winner.reservedFor.slot.e.name}; controleer of de cooldown op tijd afloopt.`:` Let op: hij staat ook gepland voor ${winner.reservedFor.slot.e.name}; je kunt er nu voor kiezen hem te bewaren.`;
  if(alternate&&alternate.reservedFor&&!winner.reservedFor)reason+=` ${alternate.m.name} is voorlopig voorzien voor ${alternate.reservedFor.slot.e.name}.`;
  if(eventConfidence.level!=='strong')reason+=' De wilde-spawngegevens zijn deels onzeker.';
  return {kind:isActive?'active':'free',title:winner.m.name,message:reason,event:e};
}
function rotationSuggestionV40(now,plan){
  const active=db.megas.find(m=>activeMega(m)&&megaActiveAt(m,now));
  if(!active)return null;
  const end=megaEndAt(active);
  if(!end||end.getTime()-now.getTime()<10*60000)return null;
  // Never suggest losing an active bonus during an ongoing eligible wild-spawn event.
  const live=db.events.some(e=>eventEligibleV31(e)&&dt(e.start)&&dt(e.end)&&dt(e.start)<=now&&dt(e.end)>now);
  if(live)return null;
  const future=(plan||[]).flatMap(day=>day.actions||[]).filter(x=>
    x.slot?.t>now&&['event','active'].includes(x.action?.kind)&&x.action.m);
  const candidates=db.megas.filter(m=>activeMega(m)&&m.id!==active.id&&stateAt(m,now).kind==='free')
    .map(m=>{
      const fullReady=now.getTime()+8*V31_HOUR+coolDays(m)*V31_DAY;
      const reserved=future.some(x=>x.action.m.id===m.id&&x.slot.t.getTime()<fullReady);
      return {m,reserved,progress:+m.level<3&&!alreadyLeveledOnV32(m,now)};
    }).filter(x=>!x.reserved)
    .sort((a,b)=>Number(b.progress)-Number(a.progress)||coolDays(a.m)-coolDays(b.m)||a.m.name.localeCompare(b.m.name));
  if(!candidates.length)return null;
  const candidate=candidates[0].m;
  const readyIfWait=new Date(end.getTime()+coolDays(active)*V31_DAY);
  const readyIfSwitch=new Date(now.getTime()+coolDays(active)*V31_DAY);
  const futureOfActive=future.find(x=>x.action.m.id===active.id&&x.slot.t.getTime()<readyIfWait.getTime());
  // A genuinely important future event may benefit from the earlier ending.
  const note=futureOfActive?` Dit kan relevant zijn voor ${futureOfActive.slot.e.name}.`:'';
  return {active,candidate,readyIfWait,readyIfSwitch,
    message:`Als je niet meer vangt met de bonus van ${active.name}, kun je vrijwillig naar ${candidate.name} wisselen (alleen als deze in Pokémon GO GRATIS is). Dan eindigt ${active.name} nu en wordt deze volgens de berekening opnieuw gratis op ${fmtDay(readyIfSwitch)} om ${fmtTime(readyIfSwitch)}, in plaats van ${fmtDay(readyIfWait)} om ${fmtTime(readyIfWait)}. Wissel niet als je de huidige bonus nog nodig hebt.${note} Registreer beide echte evoluties op het werkelijke tijdstip.`};
}
