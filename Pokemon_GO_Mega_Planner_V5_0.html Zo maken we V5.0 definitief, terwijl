    const next=new Date(info.futureConflictAt);
    const title=info.futureConflictEvent||'een later evenement';
    return `${prefix} Beide Megas zijn volgens de simulatie beschikbaar. ${other.name} is ook gepland voor ${title} op ${fmtDay(next)} om ${fmtTime(next)}. Als je ${other.name} nu 8 uur actief houdt, zou hij daarvoor niet opnieuw gratis zijn. Dit is een aantoonbaar planningsrisico, maar geen bewijs van een optimale keuze.${names}`;
