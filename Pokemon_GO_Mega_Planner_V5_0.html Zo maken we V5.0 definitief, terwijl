/* V4.4: Event comparisons and honest bonus detail. */
.v42choice{margin:9px 0 11px;padding:11px 12px;background:#172e3e;border:1px solid #4d7987;border-radius:12px;font-size:12px;line-height:1.55}
.v42choice>b{display:block;font-size:12px;color:#abefe3;margin-bottom:7px}
.v42choice>div:not(.unused):not(.v43coverage){display:flex;flex-wrap:wrap;gap:5px 10px;align-items:center;justify-content:space-between;border-top:1px solid #2b4c5e;padding:5px 0}
.v42choice>div span{color:#bed4dd}
.v42choice>div strong{font-size:12px;color:#f0f9ff;font-weight:700}
.v42choice p{margin:6px 0;font-size:12px;line-height:1.5;color:#d8e5ed}
.v42choice .v42alternative{color:#c3e5df;border-top:1px solid #2b4c5e;padding-top:7px;margin-top:8px}
