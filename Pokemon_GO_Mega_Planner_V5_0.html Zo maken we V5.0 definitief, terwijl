function useful(e){return !!e.catch && typesFor(e).length>0}
function score(m,e){let matched=matching(m,e);if(!activeMega(m)||!matched.length||!useful(e))return -1;let p=rarityScore(e);let weights=goal==='xl' ? 6*xl(m)+14*candy(m) : 2*xl(m)+8*candy(m)+(m.level<3?180:0);let cover=(matched.length-1)*16;let ambiguity=typesFor(e).length>4?Math.min(25,typesFor(e).length*3):0;let confidenceDiscount=e.confidence==='title'?65:e.confidence==='legacy'?110:0;return p*100+weights+cover-ambiguity-confidenceDiscount}
function bestFor(e,t){if(!useful(e))return null;let c=db.megas.filter(activeMega).map(m=>({m,pts:score(m,e),st:stateAt(m,t)})).filter(x=>x.pts>0);c.sort((a,b)=>b.pts-a.pts);if(!c.length)return null;let avail=c.filter(x=>x.st.kind==='active'||x.st.kind==='free');return avail[0]||c[0]}
function highValueFuture(m,d){let until=daysAfter(d,coolDays(m));let matches=db.events.filter(e=>{let s=dt(e.start);if(!(s&&s>dayEnd(d)&&s<until&&rarityScore(e)>=8&&useful(e)&&matching(m,e).length>0))return false;let best=db.megas.filter(activeMega).map(x=>({x,value:score(x,e)})).sort((a,b)=>b.value-a.value)[0];return best&&best.x.id===m.id});matches.sort((a,b)=>score(m,b)-score(m,a)||dt(a.start)-dt(b.start));return matches[0]||null}
