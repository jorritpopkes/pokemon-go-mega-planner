function rarityScore(e){let cat=String(e.category||'').toLowerCase(),name=String(e.name||'').toLowerCase();if(e.manual||String(e.id||'').startsWith('customevent_'))return 8;if(/community day/.test(name))return 10;if(/spotlight hour|spotlight/.test(name))return 9;if(/raid day|super mega raid day/.test(name))return 9;if(/raid hour/.test(name))return 8;if(/raid battles|mega raids|5.?star raids/.test(name))return 6;if(/max battle|eternamax/.test(name))return 3;if(/tour|safari|wild area|go fest/.test(name))return 7;if(cat==='tba')return 5;if(/event|raids/.test(cat))return 4;return 2}
