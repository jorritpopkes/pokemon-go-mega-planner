/* V5.0: Compacte weergave met toegankelijk uitklapbare aanvullende informatie. */
.v47fold{background:#17263b;border:1px solid #344b64;border-radius:12px;margin:10px 0;overflow:hidden}
.v47fold>summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;padding:11px 13px;font-weight:700;font-size:13px;line-height:1.45;list-style:none;color:#e9f5ff}
.v47fold>summary::-webkit-details-marker,.v47micro>summary::-webkit-details-marker{display:none}
