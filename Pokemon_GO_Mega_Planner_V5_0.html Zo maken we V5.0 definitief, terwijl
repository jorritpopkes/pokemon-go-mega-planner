function eventPriorityV31(e){
  if(/community day/i.test(e.name))return 100;
  if(/spotlight hour/i.test(e.name))return 90;
  if(e.manual)return 85;
  if(/go fest|wild area|safari/i.test(e.name))return 77;
  if(/raid day/i.test(e.name))return 50;
  return 35;
