function typesFor(e){
  // Vanaf V3 mogen raid-, research- of Max Battle-types niet als wild spawn meetellen.
  if(e.schemaVersion===3)return Array.isArray(e.wildTypes)?e.wildTypes.filter(t=>TYPES.includes(t)):[];
