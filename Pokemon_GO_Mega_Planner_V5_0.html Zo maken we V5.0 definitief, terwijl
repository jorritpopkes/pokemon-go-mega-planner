    .map(x=>({m:x,points:eventRewardV35(x,e,slot.t)}))
    .sort((a,b)=>b.points-a.points||a.m.name.localeCompare(b.m.name));
  const competitor=options.find(x=>x.m.id!==m.id)||null;
  const best=options[0]?.m.id===m.id;
  const bonus=megaBonusV42(m);
  const types=matching(m,e);
  const canAdvance=Number(m.level)<3&&!alreadyLeveledOnV32(m,slot.t)&&action.kind==='event';
  const known=confidenceV37(e).level==='strong';
