// Een Mega Evolution duurt maximaal 8 uur. Daarna pas begint de rustperiode.
// Een nieuwe Mega Evolution beëindigt de vorige meteen. De ingelogde datums
// blijven compatibel met eerdere V2-opslag (m.last = starttijd).
const MEGA_DURATION_MS=8*60*60*1000;
function activeMega(m){return m?.owned&&+m.level>0}
function coolDays(m){return [null,7,5,3,1][+m.level]??7}
function megaEndAt(m){
