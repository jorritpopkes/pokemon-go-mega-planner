  if(!a)return now;
  if(a<now){if(b&&b>now)return now;return null}
  return a;
}
function eventMatchScoreV31(m,e){
  if(!activeMega(m)||!matching(m,e).length)return -1;
  let match=matching(m,e).length,bonus=goal==='xl'?xl(m)*3+candy(m)*14:(4-Number(m.level))*45+xl(m);
  return 100+match*90+bonus+(eventPriorityV31(e)/10);
}
function nextReadyAtV31(m,current,sim){
  const entry=sim.get(m.id);
  if(entry)return entry;
  const state=stateAt(m,current);
  if(state.kind==='free')return new Date(current.getTime());
  if(state.kind==='waiting'||state.kind==='active')return state.free||null;
  return null;
}
function reservedForV31(m,at,cooldownEnds,majorSlots){
  if(!at||!cooldownEnds)return null;
  for(let {e,t} of majorSlots){
    if(t<=at||t>=cooldownEnds)continue;
    if(!matching(m,e).length)continue;
    const own=eventMatchScoreV31(m,e);
    const alternatives=db.megas.filter(x=>x.id!==m.id&&activeMega(x)&&matching(x,e).length)
      .map(x=>eventMatchScoreV31(x,e)).filter(x=>x>=0);
    const bestOther=alternatives.length?Math.max(...alternatives):-1;
    // Protect the only compatible Mega, or a materially stronger candidate.
    if(bestOther<0||own>=bestOther+35)return e;
