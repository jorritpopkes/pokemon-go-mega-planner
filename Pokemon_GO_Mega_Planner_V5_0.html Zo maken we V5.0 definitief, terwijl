.v47fold[open]>summary:before,.v47micro[open]>summary:before{content:'▾'}
.v47fold>summary:focus-visible,.v47micro>summary:focus-visible{outline:2px solid #90e6ac;outline-offset:-3px}
.v47foldBody{padding:2px 12px 12px}
.v47trust{margin:8px 0;padding:0}
