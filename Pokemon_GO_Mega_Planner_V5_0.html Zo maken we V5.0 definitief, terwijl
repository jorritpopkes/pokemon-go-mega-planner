function eventRewardV35(m,e,at=dt(e.start)||new Date()){
  const typeMatches=matching(m,e).length;
  if(!typeMatches||!activeMega(m))return -1;
  const p=eventPriorityV31(e);
  const weight=p>=100?5:p>=90?4:p>=80?3:p>=70?2.25:1;
  const quality=e.confidence==='title'?0.7:e.confidence==='partial'?0.85:e.confidence==='legacy'?0.6:1;
  const tier=Math.max(0,Math.min(4,Number(m.level)||0));
  const xlTier=[0,0,12,32,50][tier];
  const canAdvance=tier<3&&!alreadyLeveledOnV32(m,at);
  const progress=canAdvance?(tier===1?75:45):0;
  // Use distinct wild Pokémon where the Pokédex provides their types.
  // A dual-type Pokémon counts once; no spawn frequency is assumed.
  const species=speciesCoverageV43(m,e);
  const knownShare=species.known?species.covered.length/species.known:0;
  const speciesWeight=species.known?
    (28*Math.min(species.covered.length,3)*(0.55+0.45*knownShare)+15*knownShare):
    28*typeMatches;
