    // Fail closed on a sudden loss of most events or many previously listed wild species.
    const recent=previous.filter(e=>dt(e.end)&&dt(e.end).getTime()>Date.now()-2*86400000);
    if(recent.length>=15&&upcoming.length<recent.length*0.35&&upcoming.length<=recent.length-10)
