function isMainEvent(e){let start=dt(e.start),end=dt(e.end),length=start&&end?(end-start)/86400000:0;if(e.manual||String(e.id||'').startsWith('customevent_'))return true;if(isBackground(e)||/twilight trails/i.test(String(e.name||'')))return false;if(length>14&&rarityScore(e)<8)return false;return rarityScore(e)>=6 || /spotlight|raid|community|twilight wishes|dynamax trails|eternamax/i.test(String(e.name||''))}
