height:1.3}.dateBadge strong{display:block;font-size:22px}.headEvents{color:var(--muted);font-size:12px;margin:4px 0}.scrollx{overflow-x:auto;display:flex;gap:7px;scrollbar-width:thin;margin:9px 0 13px}.datechip{flex:0 0 64px;min-width:64px;color:var(--text);border:1px solid var(--line);background:var(--card);border-radius:12px;padding:8px 4px;text-align:center}.datechip.active{outline:2px solid var(--cyan);background:#23434e}.datechip strong{display:block;font-size:20px}.datechip small{display:block;color:var(--muted)}.eventCard{padding:12px 14px;background:#1c2b43;border:1px solid var(--line);border-radius:12px;margin-bottom:8px}.eventCard .name{font-size:15px;font-weight:780}.line{height:1px;background:var(--line);margin:12px 0}.tagRow{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.tag{background:#273a56;padding:3px 8px;border-radius:8px;font-size:12px;color:#c5d8ed}.megaGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:10px}.mega{margin:0}.mega .meta{font-size:12px;color:var(--muted)}.mega .cmds{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.split{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:start}.typeGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.typeCard{border:1px solid var(--line);border-radius:12px;padding:11px;background:var(--card)}.typeCard span{display:block;color:var(--muted);font-size:12px}.dialog{position:fixed;inset:0;background:#030816d9;display:none;align-items:end;justify-content:center;padding:10px;z-index:50}.dialog.show{display:flex}.modal{width:min(540px,100%);max-height:93dvh;overflow:auto;border-radius:18px;background:#1a2940;padding:18px;border:1px solid #506582}.formGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:15px 0}.span2{grid-column:1/-1}.footer{color:var(--muted);font-size:11px;margin:30px 6px}.dot{width:8px;height:8px;border-radius:20px;background:var(--cyan);display:inline-block}.empty{color:var(--muted);padding:12px 0}.checkitem